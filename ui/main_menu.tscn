[node name="ControlsText" type="Label" parent="HowToPlayPanel/MarginContainer/ContentPanel/Margin/VBox/ScrollContainer/InstructionsVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.8, 1)
theme_override_font_sizes/font_size = 15
text = "• W A S D  —  Move your character
• SPACE  —  Attach to the ball (so you can hit it)
• MOUSE  —  Aim where you want to shoot the ball
• Hold SPACE to charge your shot, release to fire
• The longer you hold, the stronger the shot!"
autowrap_mode = 2

