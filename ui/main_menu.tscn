theme_override_font_sizes/font_size = 15
text = "• W A S D  —  Move your character
• SPACE or LEFT CLICK  —  Attach to the ball (so you can hit it)
• MOUSE  —  Aim where you want to shoot the ball
• Hold SPACE or LEFT CLICK to charge your shot, release to fire
• RIGHT CLICK or ESC  —  Cancel your shot while charging
• The longer you hold, the stronger the shot!"
autowrap_mode = 2

